{
  "name": "bookkeeping",
  "version": "0.0.1",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "openapi:emit": "npm run openapi:emit -w @headless-bookkeeping/server",
    "cli:codegen": "npm run openapi:emit && openapi-typescript packages/cli/openapi.json -o packages/cli/src/types.gen.ts",
    "eval:triage:tools": "npx -y promptfoo@latest eval -c evals/triage/toolcall.yaml",
    "eval:triage:classify": "npx -y promptfoo@latest eval -c evals/triage/classify.yaml",
    "eval:triage:classify-outgoing": "npx -y promptfoo@latest eval -c evals/triage/classify-outgoing.yaml",
    "eval:view": "npx -y promptfoo@latest view"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
