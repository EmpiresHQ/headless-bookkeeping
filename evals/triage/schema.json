{
  "name": "triage_result",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kind": { "type": "string", "enum": ["new_expense", "correction", "duplicate", "unknown"] },
      "document_type": { "type": "string", "enum": ["receipt", "invoice", "unknown"] },
      "gross_amount": { "type": "integer", "description": "Total gross in MINOR units (cents)" },
      "vat_amount": { "type": "integer", "description": "VAT in MINOR units (cents)" },
      "currency": { "type": "string", "description": "ISO 4217, 3 letters" },
      "tax_point_date": { "type": "string", "description": "ISO date YYYY-MM-DD" },
      "category": { "type": "string" },
      "document_vat_marking": { "type": ["string", "null"] },
      "confidence": { "type": "number" },
      "supplier_proposal": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "description": "The supplier identity proposal. mode 'create' when no existing supplier is known (the only mode in this no-tools eval). Carry EVERY identifier the document prints; null for any it does not. NEVER fabricate a registration key.",
        "properties": {
          "mode": { "type": "string", "enum": ["match", "create"] },
          "match_entity_id": { "type": ["integer", "null"] },
          "create_name": { "type": ["string", "null"] },
          "create_country": { "type": ["string", "null"], "description": "ISO 3166-1 alpha-2 country code" },
          "create_registration_key": { "type": ["string", "null"], "description": "VAT / company registry number printed on the document — null if none is printed" },
          "create_email": { "type": ["string", "null"] },
          "create_phone": { "type": ["string", "null"] },
          "create_address": { "type": ["string", "null"] }
        },
        "required": [
          "mode",
          "match_entity_id",
          "create_name",
          "create_country",
          "create_registration_key",
          "create_email",
          "create_phone",
          "create_address"
        ]
      }
    },
    "required": [
      "kind",
      "document_type",
      "gross_amount",
      "vat_amount",
      "currency",
      "tax_point_date",
      "category",
      "document_vat_marking",
      "confidence",
      "supplier_proposal"
    ]
  }
}
