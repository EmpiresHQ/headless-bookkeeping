# Copy to evals/triage/.env (gitignored) and fill in. Nothing about the
# inference deployment is committed to the repo.

# Base URL of your OpenAI-compatible inference endpoint (matches ai_base_url).
EVAL_BASE_URL=https://your-endpoint.example/v1

# Model id the endpoint expects (matches ai_model without the provider prefix).
EVAL_MODEL=your-model

# Inference API key (matches ai_api_key). promptfoo reads OPENAI_API_KEY.
OPENAI_API_KEY=sk-...
