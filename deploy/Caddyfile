{
	email {env.ACME_EMAIL}
	# ACME DNS-01 via the Cloudflare plugin — no inbound :80, works on a tailnet
	# IP. Needs CLOUDFLARE_API_TOKEN (Zone:DNS:Edit + Zone:Read).
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

# Served on :443 inside the tailscale netns → the sidecar's tailnet IP. Point a
# Cloudflare A record for SITE_DOMAIN at that 100.x (DNS-only).
{$SITE_DOMAIN} {
	reverse_proxy app:3000
	encode gzip
	log {
		output stdout
		format json
	}
}
