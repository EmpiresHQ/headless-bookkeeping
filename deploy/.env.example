# Public domain Cloudflare serves and proxies to this node.
SITE_DOMAIN=books.example.com

# Cloudflare API token for ACME DNS-01 (Caddy auto-issues Let's Encrypt certs).
# Create at: My Profile → API Tokens → Create Token → "Edit zone DNS",
# scoped to this zone. Needs Zone:DNS:Edit (+ Zone:Read).
CF_API_TOKEN=cf_xxx

# Where Caddy forwards traffic.
#  • Single node (app + Caddy together): app:3000   (default)
#  • Split (Caddy edge → private app node over the tailnet): use the app node's
#    Tailscale IP, e.g. 100.101.102.103:3000  (MagicDNS names don't resolve
#    inside the Caddy container — use the 100.x address, or run Caddy with
#    network_mode: host).
APP_UPSTREAM=app:3000
