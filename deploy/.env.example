# === Tailscale ===
TS_HOSTNAME=headless-bookkeeping
# Reusable, non-ephemeral auth key (ideally tagged) from admin → Settings → Keys.
TS_AUTHKEY=tskey-auth-xxxx

# === Domain & TLS (Caddy terminates TLS on the tailnet IP via CF DNS-01) ===
SITE_DOMAIN=books.empireshq.com
ACME_EMAIL=admin@empireshq.com
# Cloudflare API token: Zone:DNS:Edit + Zone:Read, scoped to the zone.
CLOUDFLARE_API_TOKEN=cf_xxx

# === Registry image (must match the DOCKER_IMAGE repo secret in ci.yml) ===
DOCKER_IMAGE=registry.empireshq.com/headless-bookkeeping

# APP_IMAGE_TAG is injected by the deploy workflow (= commit SHA). Leave unset
# locally to default to :latest.
