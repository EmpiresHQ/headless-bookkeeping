# Public domain Cloudflare serves and proxies to this node.
SITE_DOMAIN=books.example.com

# Cloudflare API token for ACME DNS-01 (Caddy auto-issues Let's Encrypt certs).
# Create at: My Profile → API Tokens → Create Token → "Edit zone DNS",
# scoped to this zone. Needs Zone:DNS:Edit (+ Zone:Read).
CF_API_TOKEN=cf_xxx

# Tailscale auth key (reusable or ephemeral) from the admin console:
# Settings → Keys → Generate auth key. Tag it so ACLs can target the node.
TS_AUTHKEY=tskey-auth-xxxx
TS_HOSTNAME=headless-bookkeeping

# Registry image CI pushes to (must match the DOCKER_IMAGE repo secret used by
# .github/workflows/ci.yml). The VPS pulls this; it does not build the app.
DOCKER_IMAGE=registry.example.com/headless-bookkeeping

# Where Caddy forwards traffic.
#  • Single node (app + caddy share the tailscale netns): localhost:3000 (default)
#  • Split (Caddy edge → private app node over the tailnet): the app node's
#    Tailscale IP, e.g. 100.101.102.103:3000
APP_UPSTREAM=localhost:3000

# APP_IMAGE_TAG is injected by the deploy workflow (= commit SHA). Leave unset
# locally to default to :latest.
